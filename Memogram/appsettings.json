{
  "Memogram": {
    "ServerAddr": "http://localhost:5230",
    "TagsToAdd": [ "memogram" ],
    "Icons": {
      "Human": "👤",
      "Bot": "🤖"
    },
    "MediaCacheTtl":  "00:00:30"
  },
  "Telegram": {
    "BotToken": "",
    "BotProxyAddr": "",
    "Proxy": "",
    "AllowedUsernames": "",
    "OnlyLikeSavedMessageWith": "",
    "SearchReplyMessagesTrim": 200
  },
  "LocalStorage": {
    "File": "data.txt"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/memogram-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
