{
  "Memogram": {
    "ServerAddr": "http://localhost:5230",
    "TagsToAdd": [ "memogram" ],
    "Icons": {
      "Human": "👤",
      "Bot": "🤖"
    },
    "MediaCacheTtl":  "00:00:30"
  },
  "Telegram": {
    "BotToken": "",
    "BotProxyAddr": "",
    "Proxy": "",
    "AllowedUsernames": "",
    "OnlyLikeSavedMessageWith": "",
    "SearchReplyMessagesTrim": 200,
    "CacheMessageForEditTime": "01:00:00"
  },
  "LocalStorage": {
    "File": "data.txt"
  },
  "Web": {
    "Address": "http://0.0.0.0",
    "Port": 8080,
    "HealthCheckTimeoutSeconds": 20
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/memogram-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
